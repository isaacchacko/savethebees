{
  "manifest_version": 3,
  "name": "cool",
  "version": "1.0.0",
  "description": "CRUD the lists on isaacchacko.com/cool, straight from Chrome.",
  "permissions": ["storage", "contextMenus", "activeTab", "notifications"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "add to cool"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
