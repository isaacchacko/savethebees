{
  "manifest_version": 3,
  "name": "library",
  "version": "2.0.0",
  "description": "CRUD the library on isaacchacko.com (and edit the rest of the site), straight from Chrome.",
  "permissions": ["storage", "contextMenus", "activeTab", "notifications"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "add to library"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
