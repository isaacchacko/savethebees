---
// The garden's foot, in place of Basalt's: the credit in the site's own words,
// and the resume and the socials.
// Every page has a footer, so the surf behind the page (islands/backdrop.ts)
// is mounted from here, and the script that plays a word's sound (.side-sound).
const SOCIALS = [
  { href: "/Isaac_Chacko.pdf", label: "resume" },
  { href: "https://www.github.com/isaacchacko", label: "github" },
  { href: "https://www.linkedin.com/in/isaacchacko", label: "linkedin" },
]
---

<div class="island" data-island="backdrop" data-island-load="eager"></div>
<footer class="garden-footer">
  <p>
    made with <a href="https://basalt.isaacchacko.com" target="_blank" rel="noopener noreferrer">basalt</a>
  </p>
  <ul>
    {
      SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

<script>
  // A word or a card row with a sound (data-sound="/assets/sound/….mp3"): click
  // it, or Enter on it, to play its clip; again to stop. Everything with that
  // clip is marked .is-playing while it plays. One sound at a time. The margin's
  // cards are copies made on hover, so this listens on the document, not on them.
  const SOUND = "[data-sound]"
  const clips = new Map<string, HTMLAudioElement>()

  const mark = (src: string, playing: boolean) => {
    for (const el of document.querySelectorAll(`[data-sound="${CSS.escape(src)}"]`)) el.classList.toggle("is-playing", playing)
  }

  function toggle(src: string) {
    let clip = clips.get(src)
    if (!clip) {
      clip = new Audio(src)
      clip.addEventListener("play", () => mark(src, true))
      for (const stop of ["pause", "ended"]) clip.addEventListener(stop, () => mark(src, false))
      clips.set(src, clip)
    }
    if (clip.paused) {
      for (const other of clips.values()) if (other !== clip) other.pause()
      clip.currentTime = 0
      clip.play().catch(() => {})
    } else clip.pause()
  }

  function wire() {
    for (const word of document.querySelectorAll<HTMLElement>(".side-sound:not([role])")) {
      word.tabIndex = 0
      word.setAttribute("role", "button")
    }
    // a card shown again comes back as a fresh copy: show what's playing
    for (const [src, clip] of clips) mark(src, !clip.paused)
  }
  wire()
  document.addEventListener("astro:page-load", wire)
  new MutationObserver(() => {
    for (const [src, clip] of clips) if (!clip.paused) mark(src, true)
  }).observe(document.body, { childList: true, subtree: true })

  document.addEventListener("click", (e) => {
    const el = (e.target as Element).closest?.<HTMLElement>(SOUND)
    if (!el || (e.target as Element).closest("a")) return
    toggle(el.dataset.sound!)
  })
  document.addEventListener("keydown", (e) => {
    const el = (e.target as Element).closest?.<HTMLElement>(SOUND)
    if (!el || (e.key !== "Enter" && e.key !== " ")) return
    e.preventDefault()
    toggle(el.dataset.sound!)
  })
  // leaving the page stops it
  document.addEventListener("astro:before-swap", () => clips.forEach((clip) => clip.pause()))
</script>
