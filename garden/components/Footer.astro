---
// The garden's foot, in place of Basalt's: the credit in the site's own words,
// and the resume and the socials.
// Every page has a footer, so the surf behind the page (islands/backdrop.ts)
// is mounted from here.
const SOCIALS = [
  { href: "/Isaac_Chacko.pdf", label: "resume" },
  { href: "https://www.github.com/isaacchacko", label: "github" },
  { href: "https://www.linkedin.com/in/isaacchacko", label: "linkedin" },
]
---

<div class="island" data-island="backdrop" data-island-load="eager"></div>
<footer class="garden-footer">
  <p>
    made with <a href="https://basalt.isaacchacko.com" target="_blank" rel="noopener noreferrer">basalt</a>
  </p>
  <ul>
    {
      SOCIALS.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))
    }
  </ul>
</footer>

